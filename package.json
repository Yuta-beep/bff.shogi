{
  "name": "shogi-mobile-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:lambda": "bash scripts/build-lambda-zip.sh",
    "lint": "bun run format:check && bun run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test",
    "skills:v2:catalog": "node scripts/apply-skill-definition-v2-catalog.mjs",
    "skills:v2:catalog:apply": "node scripts/apply-skill-definition-v2-catalog.mjs --apply",
    "seed:piece-images": "node scripts/seed-master-piece-image-keys.mjs",
    "seed:piece-images:apply": "node scripts/seed-master-piece-image-keys.mjs --apply",
    "seed:piece-images:storage": "node scripts/upload-piece-images-to-storage.mjs",
    "seed:piece-images:storage:apply": "node scripts/upload-piece-images-to-storage.mjs --apply --update-db",
    "seed:pieces:catalog": "node scripts/seed-master-piece-from-html.mjs",
    "seed:pieces:catalog:apply": "node scripts/seed-master-piece-from-html.mjs --apply",
    "db:sync:piece-catalog": "node scripts/generate-piece-catalog-sync-migration.mjs",
    "db:publish:gachas:apply": "node scripts/publish-active-gachas.mjs --apply",
    "db:sync:gacha:kanken1:apply": "node scripts/sync-kanken1-gacha-pool.mjs --apply",
    "db:sync:gacha:all:apply": "node scripts/sync-all-gacha-pools.mjs --apply",
    "db:sync:baku-move-desc:apply": "node scripts/apply-baku-move-description.mjs --apply",
    "db:sync:aori-move-desc:apply": "node scripts/apply-aori-move-description.mjs --apply",
    "db:sync:shitsu-move-desc:apply": "node scripts/apply-shitsu-move-description.mjs --apply",
    "db:sync:sadame-move-desc:apply": "node scripts/apply-sadame-move-description.mjs --apply",
    "db:sync:an-move-desc:apply": "node scripts/apply-an-move-description.mjs --apply",
    "db:sync:so-move-desc:apply": "node scripts/apply-so-move-description.mjs --apply",
    "db:sync:hen-move-desc:apply": "node scripts/apply-hen-move-description.mjs --apply",
    "db:sync:itsu-move-desc:apply": "node scripts/apply-itsu-move-description.mjs --apply",
    "db:sync:shin-move-desc:apply": "node scripts/apply-shin-move-description.mjs --apply",
    "db:sync:nige-move-desc:apply": "node scripts/apply-nige-move-description.mjs --apply",
    "db:sync:sou-move-desc:apply": "node scripts/apply-sou-move-description.mjs --apply",
    "db:sync:en-move-desc:apply": "node scripts/apply-en-move-description.mjs --apply",
    "db:sync:kou-move-desc:apply": "node scripts/apply-kou-move-description.mjs --apply",
    "db:sync:gacha-roll-costs:apply": "node scripts/apply-gacha-roll-costs.mjs --apply",
    "seed:pieces:catalog:images:apply": "node scripts/apply-piece-catalog-image-keys.mjs --apply",
    "seed:promoted-piece-images:storage": "node scripts/upload-promoted-piece-images-to-storage.mjs",
    "seed:promoted-piece-images:storage:apply": "node scripts/upload-promoted-piece-images-to-storage.mjs --apply",
    "seed:announcements": "bun run scripts/seed-announcements.ts",
    "seed:announcements:apply": "bun run scripts/seed-announcements.ts --apply",
    "reset:users": "node scripts/reset-auth-users.mjs",
    "reset:users:apply": "node scripts/reset-auth-users.mjs --apply",
    "db:link": "npx supabase@latest link --project-ref jxtzlgcikacuttjesfoe",
    "db:push": "npx supabase@latest db push",
    "db:migration:new": "npx supabase@latest migration new",
    "db:status": "npx supabase@latest migration list",
    "format": "biome format app src lib scripts docs .github package.json tsconfig.json next.config.ts README.md --write",
    "format:check": "biome format app src lib scripts docs .github package.json tsconfig.json next.config.ts README.md",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "dotenv": "^17.3.1",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.8.3",
    "@biomejs/biome": "^2.4.6",
    "lefthook": "^2.1.3"
  }
}
