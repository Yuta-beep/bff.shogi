aws_region                = "ap-northeast-1"
project                   = "basi-magic.shogi"
env                       = "sandbox"
lambda_zip_path           = "../../dist/lambda.zip"
lambda_architecture       = "arm64"
lambda_memory_mb          = 1024
lambda_timeout_seconds    = 30
log_retention_in_days     = 14
readiness_check_path      = "/api/health"
supabase_url              = "https://your-project.supabase.co"
supabase_service_role_key = "replace-me"
# ai_engine_base_url      = "https://your-ai-engine.example.com"
# matching_bff_internal_token = "replace-with-shared-internal-token"
# matching_ticket_secret      = "replace-with-shared-ticket-secret"
